# LotHold configuration. Copy to .env (git-ignored). Never commit real values.
# `npm run setup` generates the two required secrets below.

# --- required ---
EVIDENCE_ENCRYPTION_KEY=   # 64 hex chars (32 bytes). AES-256-GCM key for uploaded evidence at rest. Back it up.
DOWNLOAD_SIGNING_KEY=      # 64 hex chars. HMAC key for 5-minute signed download links.

# --- server ---
# PORT=8787
# HOST=127.0.0.1
# PUBLIC_ORIGIN=http://localhost:5173     # extra allowed Origin for state-changing requests
# DATABASE_PATH=data/lothold.sqlite
# EVIDENCE_DIR=data/evidence
# DATA_DIR=data/snapshots                 # raster snapshots (npm run data:fetch)
# NODE_ENV=production                     # enables Secure cookies (serve over HTTPS)
# REGISTRATION_OPEN=true                  # set false to disable self-registration
# REGISTER_RATE_LIMIT=5                   # registrations per client address per hour
# TRUST_PROXY=false                       # only set true behind a reverse proxy; the LAST X-Forwarded-For entry is used
# TRUST_PROXY_HEADER=                     # optional single-value client-IP header set by the platform, e.g. fly-client-ip
# LOTHOLD_INSTANCE=                       # set to 'engineering' only on throwaway test instances (enables test scripts)

# --- optional: model-assisted field extraction (see docs/AI.md) ---
# Without these, the deterministic label parser (not AI) is used and labelled as such.
# Google AI Studio (Gemini) example:
#   AI_PROVIDER=openai-compatible
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_MODEL=gemini-3.8-flash
# AI_PROVIDER=anthropic                   # or: openai-compatible
# AI_MODEL=claude-opus-5-5                # default for anthropic
# AI_API_KEY=                             # provider key; for anthropic, ANTHROPIC_API_KEY is also read by the SDK
# AI_BASE_URL=                            # openai-compatible only, e.g. https://api.example.com/v1

# --- optional: testnet anchoring (see docs/CHAIN.md) ---
# Testnet only. Generate keys with: node scripts/generate-testnet-keys.ts (prints addresses only).
# CHAIN_NETWORK=sepolia                   # or local-devnet
# CHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# REGISTRY_ADDRESS=0x1645604d915c55cfd61cf1492ad58ab5e4150b57
# CHAIN_DEPLOYER_KEY=                     # registrar + declarant signer (testnet key only)
# CHAIN_ACTOR_A_KEY=                      # pilot reserver signer (testnet key only)
# CHAIN_ACTOR_B_KEY=                      # second actor, used only by the engineering verification script
# CHAIN_ANCHORING=on                      # set off to disable anchoring entirely (recommended on public instances)
# CHAIN_MAX_ALLOCATIONS_PER_REQUEST=10
# CHAIN_DAILY_TX_LIMIT=30                 # per organisation per 24 h
# CHAIN_MAX_FEE_GWEI=50                   # refuse to sign above this network fee

# --- optional: landing-page demo video (see docs/DEMO_VIDEO.md) ---
# Unset: the page shows "Demo video coming soon". YouTube/Vimeo links load their player only after "Play".
# DEMO_VIDEO_URL=https://youtu.be/<video-id>      # or a Vimeo link, or https://... / /media/... .mp4 or .webm
# DEMO_VIDEO_POSTER=/media/lothold-demo-poster.jpg  # optional still image
# DEMO_VIDEO_CAPTIONS=/media/lothold-demo.en.vtt    # optional WebVTT captions for .mp4/.webm
