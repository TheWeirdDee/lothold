# Copy to deploy/hosting.env ON THE HOST. Never commit that file.
# DNS A/AAAA record must point to the host. Open inbound TCP 80 and 443.
LOTHOLD_HOST=lothold.example.org
PUBLIC_ORIGIN=https://lothold.example.org
# Generate stable keys with `npm run setup` and transfer securely.
# Do not generate fresh keys during redeploys.
EVIDENCE_ENCRYPTION_KEY=REPLACE_WITH_STABLE_64_HEX_KEY
DOWNLOAD_SIGNING_KEY=REPLACE_WITH_STABLE_64_HEX_KEY
REGISTRATION_OPEN=false
